# LLM provider: ollama (default, no key needed) | groq | claude | openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3            # optional — overrides the default model for the chosen provider
LLM_FAST_MODEL=             # optional — smaller model for research agents (saves quota)
                            # e.g. llama-3.1-8b-instant for Groq (separate 500k/day quota)
                            # if not set, all agents use LLM_MODEL

# API keys — only needed for the provider you choose
GROQ_API_KEY=your_groq_api_key_here             # required if LLM_PROVIDER=groq (free at console.groq.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here   # required if LLM_PROVIDER=claude
OPENAI_API_KEY=your_openai_api_key_here         # required if LLM_PROVIDER=openai

# Search provider: duckduckgo (default, no key needed) | tavily
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=your_tavily_api_key_here         # required if SEARCH_PROVIDER=tavily

# Optional: GitHub token for higher rate limits in the GitHub agent
GITHUB_TOKEN=your_github_token_here

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=swarm-intel
